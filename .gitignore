# Python caches and build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Local environments and editor files
.venv/
venv/
.env
.env.*
!.env.example
.vscode/
.idea/

# Generated analyses and downloaded reference files. Runs are not
# committed, with one exception kept as a worked example: the
# BUB1B_up run. `/results/*` rather than `/results/` because git
# does not descend into an excluded DIRECTORY, so a negation
# inside one is never read.
/results/*
!/results/BUB1B_up/
# Docking scratch is intermediate and large; the run's own
# outputs are what is worth keeping.
/results/BUB1B_up/docking_work/
/shortlist_*.md
/promoter-tf-drugs_attempt/
/\.cache/
/data/remap*.bed.gz

# OS files
.DS_Store
Thumbs.db

# Downloaded reference data. Re-fetchable (scripts/setup_data.bat pulls
# all of them), large, and versioned upstream - so the repo tracks the code that
# uses them, not the data itself. remap2022.bed.gz alone is ~1.4 GB and
# GitHub hard-rejects anything over 100 MB.
/data/jaspar2024.txt
/data/trrust.tsv
/data/rna_tissue_consensus.tsv
# Dosage tolerance: gnomAD constraint (91 MB, over the 100 MB GitHub
# limit once a release grows) and the ClinGen curation list, which is
# re-dated weekly upstream.
/data/gnomad*.tsv
/data/gnomad*.txt
/data/gnomad_constraint.tsv
/data/ClinGen_gene_curation_list_*.tsv
/data/clingen_dosage.tsv
/data/*.bed
/data/*.bed.gz
/data/*_median_tpm.gct*
*.bed.gz
*.bigWig
*.2bit

# Panel and single-gene run products
/panel/
/examples/*/results.json

# Downloaded reference corpora used by the offline routes. All re-fetchable
# in seconds, and together ~63 MB - the repo tracks the code that reads them.
/data/*.gmt
/data/lincs_geneinfo.txt
/data/gencode*.gtf*
/data/*.gtf
/data/*.gtf.gz

# Both spellings of each: git matches these case-sensitively on
# Linux and case-insensitively on Windows, so a rule written in one
# case passes locally and fails in CI. The registry accepts both.
/data/CRISPR*.csv
/data/crispr*.csv
/data/Model.csv
/data/model.csv
/data/depmap*.csv

/docking_work/

/data/creeds_*.gmt
/data/drugmatrix*.gmt
/data/tggates_*.gmt

/data/hgnc_complete_set.*
/data/goa_human.*
/data/gwas_catalog*.tsv
/data/BindingDB_All.tsv*
/data/bindingdb*.tsv
/data/bindingdb_distilled.tsv
/data/BindingDB_All_*_tsv.zip
/data/chembl*.db
/data/repurposing_*.txt

/data/drugcentral*
/data/zinc_*.smi
/data/ttd_*.txt
/data/superdrug*
/data/chembl_approved*
/data/library.tsv
# Not ignored on purpose: data/approved_library.tsv and the two
# data/fda_label_cmax tables ship with the repository, so a fresh clone
# can screen a library and run the dose check before any download.
# Their sources and terms are in data/README.md.
# Generated by chipregulon.py from the ReMap BED. 21 MB and
# reproducible from the inputs, so it is built, not stored.
/data/chip_regulon.tsv
/data/ctd_fame.tsv
/data/collectri.*
/data/approved_library.csv
/data/repurposing_hub.tsv
# PRISM and expression matrices for the sensitivity scan.
/data/Repurposing_Public*
# The registry also accepts the name with the PRISM_ prefix, which
# the rule above does not reach.
/data/PRISM_Repurposing_Public*
/data/prism_*.csv
/data/OmicsExpression*
/data/CCLE_expression*
/data/ccle_expression*

/data/products.txt
/data/Products.txt
/data/EOBZIP.zip
/data/orange_book_products.txt

# Partial downloads and archives left in data/ by scripts/setup_data.py
/data/*.part
/data/*.zip

# Named regulators of the transcript: built by
# scripts/build_transcript_sites.py from TargetScan, miRTarBase and ENCODE
# eCLIP, each of which sets its own terms. The sources are kept under
# transcript_sites_src/ so a rebuild does not fetch a gigabyte again.
/data/transcript_sites.tsv
/data/transcript_sites_src/

# Other filenames the loaders accept (generoutes/datasets.py lists them all).
# A test checks that every one is ignored, so a download cannot be committed
# by accident.
/data/drug_protein_abundance.tsv
/data/transcript_expression.tsv
/data/chembl_*_sqlite/
/data/common_essentials.csv
/data/hgnc.tsv
/data/hg38.fa
/data/genome.fa

# ProTargetMiner's workbook, kept so a rebuild of the protein table does
# not fetch it again. CC BY 4.0, but 17 MB and versioned upstream.
/data/protein_abundance_src/
