# Line endings, pinned.
#
# Without this, the result depends on each person's `core.autocrlf` setting
# rather than on the repository. On Windows that defaults to `true`, so Git
# rewrites LF to CRLF on checkout and back to LF on commit — which is why
# GitHub Desktop reports "a change in line endings from 'LF' to 'CRLF'".
#
# It is harmless until two people have different settings, at which point
# one of them commits a whole file as changed because every line's ending
# moved. These rules make the answer the same on every machine.

# Text files: normalise to LF in the repository, whatever the OS does locally.
* text=auto eol=lf

# Windows batch files are the exception — cmd.exe can mis-parse `goto` and
# label handling in an LF-only .bat, so these keep CRLF on disk.
*.bat text eol=crlf
*.cmd text eol=crlf

# Data and binaries: never transform. A line-ending rewrite inside a gzip
# stream or a compiled file corrupts it.
*.gz      binary
*.zip     binary
*.bed     binary
*.bigWig  binary
*.bw      binary
*.2bit    binary
*.pyc     binary
*.png     binary
*.jpg     binary
*.pdf     binary
