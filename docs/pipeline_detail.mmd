%% Compact flowchart of one run. The one-screen timeline is pipeline.mmd. Source of truth: docs/how-it-works.md.
flowchart TD
    subgraph A["Start"]
        direction LR
        SETUP["setup_data.bat<br/>fetch reference files"] --> IN["Input: gene, goal,<br/>dosage scenario, tissue"]
    end

    subgraph B["Factor route, stages 1 to 7"]
        direction LR
        S1["1 Promoter<br/>Ensembl or GENCODE"] --> S2["2 Scan<br/>JASPAR p 1e-5<br/>chance from shuffles"] --> W{"no signal?"}
        W -- yes --> WIDE["rescan<br/>-5000/+1000"] --> S34
        W -- no --> S34["3-4 Factors<br/>GO role, ReMap ChIP"] --> S57["5-7 Drugs<br/>rank, approved drug<br/>by direction, grade"]
    end

    subgraph C["Stage 8: twelve routes beside it"]
        R["own product - upstream network - LINCS - factor activity<br/>receptor screens - docking - DepMap and PRISM - known regulators<br/>evidence only: genetics - CTD - dosage<br/>own section: designed modalities"]
    end

    subgraph D["Merge, stages 9 to 11"]
        direction LR
        CAT["9 Catalogue<br/>tier 1 to 5, three axes"] --> LEDGER["10 Verdict<br/>ledger of sources"] --> FDA{"FDA approved<br/>only"} --> OUT["11 Files<br/>report, summary,<br/>results.json"]
    end

    subgraph E["Around it"]
        direction LR
        LAUNCH["run_everything.bat<br/>5 stages, dose check,<br/>opt-in AlphaFold dock"]
        CHECKS["Checks on saved results<br/>retrospective, where drugs are lost,<br/>regulator gain, drug trace, exposure"]
    end

    A --> B
    A --> C
    B --> D
    C --> D
    D --> E

    classDef gate fill:#f8dedb,stroke:#b3261e;
    class W,FDA gate;
