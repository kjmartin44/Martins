%% The same run in more detail, naming all eighteen routes.
%% The short version is pipeline.mmd. Source of truth: docs/how-it-works.md.
flowchart TD
    START["Choose a gene, a direction,<br/>and what is wrong with the alleles"]

    subgraph ON_GENE["On the gene itself"]
        R1["1 drugs already acting on<br/>its protein or transcript"]
        R13["13 compounds predicted to<br/>bind its protein"]
        R14["14 compounds measured to<br/>move its protein"]
    end

    subgraph MEASURED["Measured on the gene"]
        R4["4 chemicals the literature<br/>records as moving it (CTD)"]
        R6["6 compounds whose LINCS<br/>signature contains it"]
        R12["12 compounds that phenocopy<br/>losing a factor (PRISM)"]
    end

    subgraph VIA_TF["Through a factor at the promoter"]
        PROM["Find the promoter"] --> SCAN["Scan for binding spots"]
        SCAN --> NULL["Shuffle the same window:<br/>how many spots does<br/>chance alone give?"]
        NULL --> Q{"Anything<br/>stands out?"}
        Q -- no --> WIDE["Search a wider stretch"] --> CHECK
        Q -- yes --> CHECK["What each factor does,<br/>whether it is really bound,<br/>and whether it is active"]
        CHECK --> R2["2 approved drugs at<br/>those factors"]
        CHECK --> R9["9 ligand screen:<br/>an established ligand"]
        CHECK --> R10["10 ligand screen:<br/>a new hypothesis"]
        CHECK --> R11["11 docking, once the<br/>pocket passes a control"]
        CHECK --> R7["7 compounds that change<br/>a factor's own transcript"]
        CHECK --> R8["8 compounds that move<br/>a factor's inferred activity"]
        CHECK --> R16["16 the factor's own<br/>endogenous ligand"]
        CHECK --> R18["18 stabilisers, glues and<br/>degradation blockers:<br/>the routes for a factor<br/>with no ligand pocket"]
    end

    subgraph NO_FACTOR["Past the factor entirely"]
        R15["15 chromatin-level agents<br/>HDAC, DNMT and EZH2:<br/>genome-wide, not this gene"]
        R17["17 DNA-binding agents for a<br/>sequence feature of this promoter,<br/>only where it beats a shuffle"]
    end

    subgraph AROUND["Around the factor"]
        R3["3 drugs further upstream:<br/>TF to kinase to receptor"]
        R5["5 drugs at its recorded<br/>regulators (CollecTRI)"]
    end

    subgraph AFTER["Annotated, with no drug matched to them"]
        A1["splicing and isoform choice:<br/>decay exons an oligo could skip,<br/>each weighed by the message<br/>its isoforms carry in GTEx"]
        A2["translation:<br/>upstream ORFs in the 5'UTR,<br/>G-quadruplexes, a 5'TOP motif"]
        A3["mRNA stability:<br/>AU-rich elements in the 3'UTR,<br/>Pumilio sites, the m6A consensus,<br/>and measured methylation from REPIC"]
        A4["degradation:<br/>the ligase that destroys the protein,<br/>and the enzyme that reverses it"]
        A6["named regulators:<br/>which miRNA or RBP acts on it,<br/>from TargetScan, miRTarBase and<br/>ENCODE eCLIP, with measured sites<br/>counted apart from predicted"]
    end

    START --> ON_GENE
    START --> MEASURED
    START --> PROM
    START --> AROUND
    START --> NO_FACTOR
    START --> AFTER

    ON_GENE --> NARROW["Weigh the collateral<br/>how many genes the factor runs<br/>how body-wide the factor is<br/>how many systems the drug moves<br/>whether a selective ligand can exist"]
    MEASURED --> NARROW
    VIA_TF --> NARROW
    AROUND --> NARROW
    NO_FACTOR --> NARROW

    NARROW --> GATES["Demote what the evidence cannot carry<br/>a scan that is mostly noise<br/>a compound that just moves the cell cycle<br/>one the literature records for every gene<br/>one that damages DNA, or raises an oncogene,<br/>when the patient cannot afford either"]
    GATES --> RANK["Rank every route by<br/>how strong its evidence is"]
    CONTEXT["Context only<br/>genetic support, safe dose range"] -.-> RANK
    LEDGER["Which lookups actually answered"] -.-> RANK
    AFTER -.-> REPORT

    RANK --> REPORT["Write up<br/>group candidates by what was measured<br/>say what ran and what failed<br/>and which of the six steps<br/>were never asked at all"]
    REPORT --> TEST["Test it<br/>the screen this analysis prioritises,<br/>and a check against what is already known"]

    A3 -.-> A6
    A2 -.-> A6

    AUDIT["Audit all six steps to a protein<br/>transcription (routes 2-11), splicing,<br/>mRNA stability, translation,<br/>folding (route 13), degradation (route 14)<br/>each marked searched, listed only, or not covered"] -.-> REPORT
